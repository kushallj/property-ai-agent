# Copy to .env and fill in. Only an LLM key is required to chat in the terminal.

# Model as "provider:model". Default uses OpenAI.
LLM_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=

# Branding used in replies
FIRM_NAME=Apna Ghar Realty
ASSISTANT_NAME=Riya

# Broker who gets hot-lead alerts and approves visits (international format)
BROKER_WHATSAPP=+919800000000

# WhatsApp Business Cloud API (Meta). Leave blank to log messages instead of sending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# Optional Google Calendar sync (also needs credentials.json from Google Cloud in this folder)
GOOGLE_CALENDAR_ID=

# Storage
DB_PATH=data/real_estate_data.db
CHECKPOINT_DB=data/checkpoints.db
MEMORY_DIR=data/memory

# Scheduled briefing, reminders and shortlists (1 = on, 0 = off)
ROUTINES_ENABLED=1
